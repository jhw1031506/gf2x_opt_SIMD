//C는 A, B와 달라야 함
static inline void schoolbook_basemul(poly8x16_t* C, poly8x16_t* A, poly8x16_t* B)
{
    uint64_t * pa, * pb, * pc;
    uint64_t tmp;
    pa = (uint64_t *)(A);
    pb = (uint64_t *)(B);
    pc = (uint64_t *)(C);
    memset(pc, 0, sizeof(uint64_t) * 4);
    for (size_t j = 0; j < 2; ++j) 
    {        
        tmp = -(pb[j] & 0x1); 
        for (size_t k = 0; k < 2; ++k)
        {
            pc[k + j] ^= pa[k] & tmp;
        }
        for (size_t i = 1; i < 64; ++i)
        {
            tmp = -((pb[j] >> i) & 0x1);
            for (size_t k = 0; k < 2; ++k)
            {
                pc[k + j] ^= (pa[k] << i) & tmp;
                pc[k + j + 1] ^= (pa[k] >> (64 - i)) & tmp;
            }
        }
    }
}

static inline void karat_128_NEON(poly8x16_t* Out, poly8x16_t* a, poly8x16_t* b){
	poly8x8_t al, ah, bl, bh;
    poly8x8_t alpah, blpbh;
    poly8x16_t D0={0}, D1={0}, D2={0};

    ah = vget_high_p8(*a);
	al = vget_low_p8(*a);
    bh = vget_high_p8(*b);
	bl = vget_low_p8(*b);

    alpah=vadd_p8(al,ah);
    blpbh=vadd_p8(bl,bh);
    // schmul64_NEON(&D1, &alpah, &blpbh);
    // schmul64_NEON(&D0, &al, &bl);
    // schmul64_NEON(&D2, &ah, &bh);
    D1 = (poly8x16_t)vmull64_a72(*(uint64_t *)&alpah, *(uint64_t *)&blpbh);
    D0 = (poly8x16_t)vmull64_a72(*(uint64_t *)&al, *(uint64_t *)&bl);
    D2 = (poly8x16_t)vmull64_a72(*(uint64_t *)&ah, *(uint64_t *)&bh);

    D1=vaddq_p8(D1,D0);
    D1=vaddq_p8(D1,D2);

    Out[0]=vcombine_p8(vget_low_p8(D0),vadd_p8(vget_high_p8(D0),vget_low_p8(D1)));
    Out[1]=vcombine_p8(vadd_p8(vget_low_p8(D2),vget_high_p8(D1)),vget_high_p8(D2));
}

static inline void SB_128_NEON(poly8x16_t* Out, poly8x16_t* a, poly8x16_t* b){

	poly8x8_t al, ah, bl, bh;
    poly8x16_t D0={0}, D1={0}, D2={0};

    ah = vget_high_p8(*a);
	al = vget_low_p8(*a);
    bh = vget_high_p8(*b);
	bl = vget_low_p8(*b);

    // schmul64_NEON(&D0, &al, &bh);
    // schmul64_NEON(&D1, &ah, &bl);
    
    D0 = (poly8x16_t)vmull64_a72(*(uint64_t *)&al, *(uint64_t *)&bh);
    D1 = (poly8x16_t)vmull64_a72(*(uint64_t *)&ah, *(uint64_t *)&bl);

    D1=vaddq_p8(D0,D1);

    // schmul64_NEON(&D0, &al, &bl);
    // schmul64_NEON(&D2, &ah, &bh);
    D0 = (poly8x16_t)vmull64_a72(*(uint64_t *)&al, *(uint64_t *)&bl);
    D2 = (poly8x16_t)vmull64_a72(*(uint64_t *)&ah, *(uint64_t *)&bh);

    Out[0]=vcombine_p8(vget_low_p8(D0),vadd_p8(vget_high_p8(D0),vget_low_p8(D1)));
    Out[1]=vcombine_p8(vadd_p8(vget_low_p8(D2),vget_high_p8(D1)),vget_high_p8(D2));
}

