void schoolbook_mul(poly8x16_t *Out, poly8x16_t *A, poly8x16_t *B, size_t size)
{
   size_t i, j;
   poly8x16_t r1[2];
   gfmul_1(r1, A, B);
   Out[0] = r1[0];
   Out[1] = r1[1];
   for (j = 1; j < size; j++)
   {
      gfmul_1(r1, A, B + j);
      Out[j] ^= r1[0];
      Out[j + 1] = r1[1];
   }
   for (i = 1; i < size; i++)
   {
      for (j = 0; j < size - 1; j++)
      {
        gfmul_1(r1, A + i, B + j);
        Out[i + j] ^= r1[0];
        Out[i + j + 1] ^= r1[1];
      }
      gfmul_1(r1, A+i, B + (size - 1));
      Out[i + size - 1] ^= r1[0];
      Out[i + size] = r1[1];
   }
}

int main(){
    poly8x16_t C_sch[GFLEN*2],C[GFLEN*2],A[GFLEN],B[GFLEN];
    uint64_t start, fin, t_sch=0, t_mul=0, t_measure=cc_overhead();
    
    for(int i=0;i<N_TEST;i++){
        random_wordstring_poly8x16(A,GFLEN);
        random_wordstring_poly8x16(B,GFLEN);
        
        start = get_cc();
        schoolbook_mul(C_sch, A,B, GFLEN);
        fin = get_cc();
        t_sch += fin-start-t_measure;

        start = get_cc();
        GFMUL(C, A, B);
        fin = get_cc();
        t_mul += fin-start-t_measure;
        if(poly_compare_8x16(C, C_sch,GFLEN*2)) {
            printf("Error: gfmul_%d produced incorrect results.\n",GFLEN);
            return 1;
        }
    }
    printf("\tCorrect.\n");
    t_sch/=N_TEST;
    t_mul/=N_TEST;
    printf("\tgfmul_%d: %ld cycles\n", GFLEN, t_mul);
    return 0;
}