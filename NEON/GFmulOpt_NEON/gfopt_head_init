void random_wordstring_poly8x16(poly8x16_t *a, long n)
{
    long i;
    for (i = 0; i < n; i++)
      {
        uint64_t r1, r2;
	    r1 = rand() | (rand() << 31);
        if (sizeof (long) > sizeof (int)){
            r1 = (r1 << 31) | rand();
        }
	    r2 = rand() | (rand() << 31);
        if (sizeof (long) > sizeof (int)){
            r2 = (r2 << 31) | rand();
        }
        a[i] = vcombine_p8(vcreate_p8(r1),vcreate_p8(r2));
      }
}

static inline  uint64_t get_cc(void)
{
    uint64_t val;
    __asm__ volatile("isb;mrs %0, pmccntr_el0" : "=r"(val));
    return val;
}
uint64_t cc_overhead(void) {
    uint64_t t0, t1, overhead = 0;
    unsigned int i;

    for(i=0;i<100000;i++) {
        t0 = get_cc();
        __asm__ volatile("");
        t1 = get_cc();
        overhead += t1 - t0;
    }
    return overhead/100000;
}

