
static inline void schoolbook_mul(poly8x16_t *Out, poly8x16_t *A, poly8x16_t *B, size_t size)
{
   size_t i, j;
   poly8x16_t r1[2];
   gfmul_1(r1, A, B);
   Out[0] = r1[0];
   Out[1] = r1[1];
   for (j = 1; j < size; j++)
   {
      gfmul_1(r1, A, B + j);
      Out[j] ^= r1[0];
      Out[j + 1] = r1[1];
   }
   for (i = 1; i < size; i++)
   {
      for (j = 0; j < size - 1; j++)
      {
        gfmul_1(r1, A + i, B + j);
        Out[i + j] ^= r1[0];
        Out[i + j + 1] ^= r1[1];
      }
      gfmul_1(r1, A+i, B + (size - 1));
      Out[i + size - 1] ^= r1[0];
      Out[i + size] = r1[1];
   }
}
