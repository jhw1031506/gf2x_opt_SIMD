void schoolbook_basemul(__m256i *Out, __m256i *A, __m256i *B)
{   
    uint64_t *p_out;
    uint64_t *p_a, *p_b;
    Out[0]=_mm256_setzero_si256();
    Out[1]=_mm256_setzero_si256();
    p_out = ((uint64_t *)Out);
    p_a = (uint64_t *) A;
    p_b = (uint64_t *) B;
    for(int i=255;i>=0;i--){
        if (((p_a[i/64] >> (i%64)) & 0x1) == 1){
            int i_tmp1=(i%64);
            int i_tmp2=64 - (i%64);
            if(i_tmp1 == 0){
                p_out[i/64  ] ^= p_b[0];
                p_out[i/64+1] ^= p_b[1];
                p_out[i/64+2] ^= p_b[2];
                p_out[i/64+3] ^= p_b[3];
            }
            else{
                p_out[i/64  ] ^= (p_b[0] << i_tmp1);
                p_out[i/64+1] ^= (p_b[1] << i_tmp1) | (p_b[0] >> i_tmp2);
                p_out[i/64+2] ^= (p_b[2] << i_tmp1) | (p_b[1] >> i_tmp2);
                p_out[i/64+3] ^= (p_b[3] << i_tmp1) | (p_b[2] >> i_tmp2);
                p_out[i/64+4] ^= (p_b[3] >> i_tmp2);
            }
        }
    }
}
