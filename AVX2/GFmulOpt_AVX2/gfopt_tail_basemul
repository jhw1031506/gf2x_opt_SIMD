static inline void karat_mult_1_PCLMULQDQ(__m256i *C, __m256i *A, __m256i *B) {

    __m128i *A128 = (__m128i *)A, *B128 = (__m128i *)B, *C128 = (__m128i *)C;
	__m128i D1[2];
	__m128i D0[2], D2[2];
	__m128i Al = _mm_loadu_si128(A128);
	__m128i Ah = _mm_loadu_si128(A128 + 1);
	__m128i Bl = _mm_loadu_si128(B128);
	__m128i Bh = _mm_loadu_si128(B128 + 1);

	//	Compute Al.Bl=D0
	__m128i DD0 = _mm_clmulepi64_si128(Al, Bl, 0);
	__m128i DD2 = _mm_clmulepi64_si128(Al, Bl, 0x11);
	__m128i AAlpAAh = _mm_xor_si128(Al, _mm_shuffle_epi32(Al, 0x4e));
	__m128i BBlpBBh = _mm_xor_si128(Bl, _mm_shuffle_epi32(Bl, 0x4e));
	__m128i DD1 = _mm_xor_si128(_mm_xor_si128(DD0, DD2), _mm_clmulepi64_si128(AAlpAAh, BBlpBBh, 0));
	D0[0] = _mm_xor_si128(DD0, _mm_unpacklo_epi64(_mm_setzero_si128(), DD1));
	D0[1] = _mm_xor_si128(DD2, _mm_unpackhi_epi64(DD1, _mm_setzero_si128()));

	//	Compute Ah.Bh=D2
	DD0 = _mm_clmulepi64_si128(Ah, Bh, 0);
	DD2 = _mm_clmulepi64_si128(Ah, Bh, 0x11);
	AAlpAAh = _mm_xor_si128(Ah, _mm_shuffle_epi32(Ah, 0x4e));
	BBlpBBh = _mm_xor_si128(Bh, _mm_shuffle_epi32(Bh, 0x4e));
	DD1 = _mm_xor_si128(_mm_xor_si128(DD0, DD2), _mm_clmulepi64_si128(AAlpAAh, BBlpBBh, 0));
	D2[0] = _mm_xor_si128(DD0, _mm_unpacklo_epi64(_mm_setzero_si128(), DD1));
	D2[1] = _mm_xor_si128(DD2, _mm_unpackhi_epi64(DD1, _mm_setzero_si128()));

	// Compute AlpAh.BlpBh=D1
	// Initialisation of AlpAh and BlpBh
	__m128i AlpAh = _mm_xor_si128(Al,Ah);
	__m128i BlpBh = _mm_xor_si128(Bl,Bh);
	DD0 = _mm_clmulepi64_si128(AlpAh, BlpBh, 0);
	DD2 = _mm_clmulepi64_si128(AlpAh, BlpBh, 0x11);
	AAlpAAh = _mm_xor_si128(AlpAh, _mm_shuffle_epi32(AlpAh, 0x4e));
	BBlpBBh = _mm_xor_si128(BlpBh, _mm_shuffle_epi32(BlpBh, 0x4e));
	DD1 = _mm_xor_si128(_mm_xor_si128(DD0, DD2), _mm_clmulepi64_si128(AAlpAAh, BBlpBBh, 0));
	D1[0] = _mm_xor_si128(DD0, _mm_unpacklo_epi64(_mm_setzero_si128(), DD1));
	D1[1] = _mm_xor_si128(DD2, _mm_unpackhi_epi64(DD1, _mm_setzero_si128()));

	
	__m128i middle = _mm_xor_si128(D0[1], D2[0]);
	C128[0] = D0[0];
	C128[1] = middle ^ D0[0] ^ D1[0];
	C128[2] = middle ^ D1[1] ^ D2[1];
	C128[3] = D2[1];
}

static inline void karat_karat_1_VPCLMULQDQ(__m256i *C, __m256i *A, __m256i *B)
{
    
    __m256i T0, T1, T2, T3, T4;
    __m256i tmp_a, tmp_b, middle, S1, S2, S3;
    __m256i mask={0,0xFFFFFFFFFFFFFFFF,0xFFFFFFFFFFFFFFFF,0};

    T0 = _mm256_clmulepi64_epi128(*A, *B, 0);
    T1 = _mm256_clmulepi64_epi128(*A, *B, 0x11);

    tmp_a = _mm256_permute4x64_epi64(*A, 0xe1) ^ _mm256_permute4x64_epi64(*A, 0x78);
    tmp_b = _mm256_permute4x64_epi64(*B, 0xe1) ^ _mm256_permute4x64_epi64(*B, 0x78);
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0);
    T3 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x11);

    tmp_a = tmp_a ^ _mm256_permute4x64_epi64(tmp_a, 0x4e);
    tmp_b = tmp_b ^ _mm256_permute4x64_epi64(tmp_b, 0x4e);
    T4 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0);

    // Compute Al.Bl=S1
    middle = T0 ^ T1 ^ T2;
    middle = _mm256_permute4x64_epi64(middle, 0xD2);
    S1 = _mm256_and_si256(middle,mask) ^ _mm256_permute2x128_si256(T0, T1, 0x20);

    // Compute Ah.Bh=S2
    middle = _mm256_shuffle_epi32(middle, 0x4e);
    S2 = _mm256_and_si256(middle,mask) ^ _mm256_permute2x128_si256(T0, T1, 0x31);

    // Compute AlpAh.BlpBh=S3
    S3 = T3 ^ _mm256_and_si256(_mm256_shuffle_epi32(T4, 0x4e),mask);
    middle = _mm256_permute4x64_epi64(T3, 0xD2);
    middle = middle ^ _mm256_shuffle_epi32(middle, 0x4e);
    
    //
    S3 ^= _mm256_and_si256(middle,mask) ^ S1 ^ S2;

    middle = _mm256_setzero_si256();
    S3=_mm256_permute4x64_epi64(S3, 0x4e);
    C[0] = _mm256_xor_si256(S1, _mm256_blend_epi32(S3,middle,0x0F));
    C[1] = _mm256_xor_si256(S2, _mm256_blend_epi32(S3,middle,0xF0));

}

static inline void karat_SB_1_VPCLMULQDQ(__m256i *C, __m256i *A, __m256i *B)
{
    
    __m256i T0, T1, T2;
    __m256i tmp_a, tmp_b, middle, S1, S2, S3;
    __m256i mask={0,0xFFFFFFFFFFFFFFFF,0xFFFFFFFFFFFFFFFF,0};
    __m256i mask_rev={0xFFFFFFFFFFFFFFFF,0,0,0xFFFFFFFFFFFFFFFF};

    T0 = _mm256_clmulepi64_epi128(*A, *B, 0);    
    T1 = _mm256_clmulepi64_epi128(*A, *B, 0x11); 

    tmp_a = *A ^ _mm256_shuffle_epi32(*A, 0x4e); 
    tmp_b = *B ^ _mm256_shuffle_epi32(*B, 0x4e); 
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0);
    T2 = T0 ^ T1 ^ T2;

    //S1 = Al*Bl
    T2=_mm256_permute4x64_epi64(T2, 0xD2);
    middle = _mm256_and_si256(T2, mask);    
    S1 = _mm256_permute2x128_si256(T0, T1, 0x20) ^ middle;

    //S2 = Ah*Bh
    T2=_mm256_shuffle_epi32(T2, 0x4e);
    middle = _mm256_and_si256(T2, mask);
    S2 = _mm256_permute2x128_si256(T0, T1, 0x31) ^ middle;

    //S3 = AlpAh*BlpBh
    tmp_a=_mm256_permute4x64_epi64(*A, 0x4e); 
    T0 = _mm256_clmulepi64_epi128(tmp_a, *B, 0);    
    T1 = _mm256_clmulepi64_epi128(tmp_a, *B, 0x11); 
    tmp_a = tmp_a ^ _mm256_shuffle_epi32(tmp_a, 0x4e); 
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0);
    T2 = T0 ^ T1 ^ T2;
    T2=_mm256_permute4x64_epi64(T2, 0x2D); 
    middle = _mm256_and_si256(T2, mask_rev);    
    S3 = _mm256_permute2x128_si256(T1, T0, 0x20) ^ middle;

    //
    T2=_mm256_shuffle_epi32(T2, 0x4e);
    middle = _mm256_and_si256(T2, mask_rev);
    S3 ^= _mm256_permute2x128_si256(T1, T0, 0x31) ^ middle;
    
    middle = _mm256_setzero_si256();

    C[0] = _mm256_xor_si256(S1, _mm256_blend_epi32(S3,middle,0x0F));
    C[1] = _mm256_xor_si256(S2, _mm256_blend_epi32(S3,middle,0xF0));


}
static inline void SB_karat_1_VPCLMULQDQ(__m256i *C, __m256i *A, __m256i *B)
{
    
    __m256i T0, T1, T2;
    __m256i tmp_a, tmp_b, S0, S1, S2;
    __m256i zero = _mm256_setzero_si256();

    //S0 = Al*Bl, S1 = Ah*Bh
    tmp_a = *A;
    tmp_b = *B;
    T0 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0);
    T1 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x01) 
        ^ _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x10);
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x11);

    T0 = T0 ^ _mm256_slli_si256(T1,8);
    T2 = T2 ^ _mm256_srli_si256(T1,8);

    S0 = _mm256_permute2x128_si256(T0, T2, 0x20);
    S1 = _mm256_permute2x128_si256(T0, T2, 0x31);
    
    //S2 = (Ah + Al) * (Bh + Bl)
    tmp_a ^= _mm256_permute4x64_epi64(tmp_a, 0x4e);
    tmp_a = _mm256_permute4x64_epi64(tmp_a, 0xB4);

    tmp_b ^= _mm256_permute4x64_epi64(tmp_b, 0x4e);
    tmp_b = _mm256_permute4x64_epi64(tmp_b, 0xB4);

    S2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b,0x00);
    T0 = _mm256_clmulepi64_epi128(tmp_a, tmp_b,0x10);

    S2 ^= _mm256_permute4x64_epi64(T0, 0x99) ^ _mm256_shuffle_epi32(T0, 0x4e); 

    //
    S2 = _mm256_permute4x64_epi64(S0^S1^S2, 0x4e);
    
    C[0] = S0 ^ _mm256_blend_epi32(S2,zero,0x0F);
    C[1] = S1 ^ _mm256_blend_epi32(S2,zero,0xF0);


}

static inline void SB_SB_1_VPCLMULQDQ(__m256i *C, __m256i *A, __m256i *B)
{

    
    __m256i T0, T1, T2, S0, S1, S2;
    __m256i tmp_a, tmp_b;
    __m256i zero = _mm256_setzero_si256();

    //C[0] = Al*Bl, C[1] = Ah*Bh

    tmp_a = *A;
    tmp_b = *B;
    T0 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x00);
    T1 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x01) 
        ^ _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x10);
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x11);

    T0 = T0 ^ _mm256_slli_si256(T1,8);
    T2 = T2 ^ _mm256_srli_si256(T1,8);

    S0 = _mm256_permute2x128_si256(T0, T2, 0x20);
    S1 = _mm256_permute2x128_si256(T0, T2, 0x31);
    
    //S2 = Ah*Bl + Al*Bh (128-bit shuffle)
    tmp_a = _mm256_permute4x64_epi64(tmp_a, 0x4e);
    T0 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x00);
    T1 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x01) 
        ^ _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x10);
    T2 = _mm256_clmulepi64_epi128(tmp_a, tmp_b, 0x11);

    T0 = T0 ^ _mm256_slli_si256(T1,8);
    T2 = T2 ^ _mm256_srli_si256(T1,8);

    S2 = _mm256_permute2x128_si256(T2, T0, 0x20) ^ _mm256_permute2x128_si256(T2, T0, 0x31);

    //
    C[0] = S0 ^ _mm256_blend_epi32(S2,zero,0x0F);
    C[1] = S1 ^ _mm256_blend_epi32(S2,zero,0xF0);


}
