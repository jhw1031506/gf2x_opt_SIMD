
void schoolbook_mul(__m256i *Out, const __m256i *A, const __m256i *B, size_t size)
{
   size_t i, j;
   __m256i r1[2];
   __m128i *A128 = (__m128i *)A, *B128 = (__m128i *)B;
   gfmul_1(r1, A128, B128);
   Out[0] = r1[0];
   Out[1] = r1[1];
   for (j = 1; j < size; j++)
   {
      gfmul_1(r1, A128, B128 + 2*j);
      //Out[j]=_mm_xor_si128(Out[j],r1[0]);
      Out[j] ^= r1[0];
      Out[j + 1] = r1[1];
   }
   for (i = 1; i < size; i++)
   {
      for (j = 0; j < size - 1; j++)
      {
        gfmul_1(r1, A128 + 2*i, B128 + 2*j);
        Out[i + j] ^= r1[0];
        Out[i + j + 1] ^= r1[1];
      }
      gfmul_1(r1, A128+2*i, B128 + 2*(size - 1));
      Out[i + size - 1] ^= r1[0];
      Out[i + size] = r1[1];
   }
}

